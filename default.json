{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":maintainLockFilesDisabled",
    ":pinAllExceptPeerDependencies",
    ":automergePatch",
    ":enableVulnerabilityAlertsWithLabel(security)",
    "github>aquaproj/aqua-renovate-config#2.9.0"
  ],
  "timezone": "Asia/Tokyo",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "schedule": [],
    "prCreation": "immediate",
    "assignees": ["blck-snwmn"]
  },
  "assignees": ["blck-snwmn"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
    },
    {
      "matchManagers": ["npm"],
      "postUpdateOptions": ["npmDedupe"]
    },
    {
      "matchManagers": ["pnpm"],
      "postUpdateOptions": ["pnpmDedupe"]
    },
    {
      "description": "Automerge minor updates of tools managed by aqua",
      "matchFileNames": [
        "**/aqua.yaml",
        "**/aqua.yml",
        "**/.aqua.yaml",
        "**/.aqua.yml"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates of aqua itself",
      "matchDepNames": ["aquaproj/aqua", "aqua"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates of GitHub Actions (excluding runtime versions passed via with:)",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates of linters, formatters, type definitions and package managers",
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "oxlint-tsgolint",
        "ruff",
        "pnpm",
        "@types/**",
        "bun-types",
        "chrome-types",
        "webmcp-types"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Keep requires-python as a range, the same way engines is handled",
      "matchDepTypes": ["requires-python"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Look up exact .python-version pins from python.org so they move with requires-python and uv",
      "matchManagers": ["pyenv"],
      "matchDepNames": ["python"],
      "matchCurrentValue": "/^\\d+\\.\\d+\\.\\d+$/",
      "overrideDatasource": "python-version"
    }
  ]
}
